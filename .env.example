# PostgreSQL
POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=changeme

# Backend
DATABASE_URL=postgresql+asyncpg://argus:changeme@postgres:5432/argus
LOG_LEVEL=INFO

# Frontend — leave unset in Docker. The app uses same-origin /api requests,
# proxied to the backend by Caddy. Only set this when running `npm run dev`
# outside Docker against a local backend:
# NEXT_PUBLIC_API_URL=http://localhost:8000
